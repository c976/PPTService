<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wx="clr-namespace:PPTServiceUltra.Ink.Core.Windows" xmlns:wn="clr-namespace:PPTServiceUltra.Ink.Core.Windows.Notifications">
  <wx:MinValueConverter x:Key="MinMultiValueConverter" />
  <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  <Style x:Key="{x:Type wn:ContentDialog}" TargetType="{x:Type wn:ContentDialog}">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="#FFFFFFFF" />
    <Setter Property="wn:ContentDialog.HideDelay" Value="0:0:0.3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type wn:ContentDialog}">
          <FrameworkTemplate.Resources>
            <ResourceDictionary>
              <Storyboard x:Key="LoadStoryboard" FillBehavior="Stop">
                <DoubleAnimation Storyboard.TargetName="Fore" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" From="0.5" Duration="0:0:0.3">
                  <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.2" />
                  </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="Fore" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" From="0.5" Duration="0:0:0.3">
                  <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.2" />
                  </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="Fore" Storyboard.TargetProperty="Opacity" Duration="0:0:0.1" />
              </Storyboard>
              <Storyboard x:Key="UnloadStoryboard">
                <DoubleAnimation Storyboard.TargetName="Fore" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="0.5" Duration="0:0:0.3">
                  <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.2" />
                  </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="Fore" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="0.5" Duration="0:0:0.3">
                  <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.2" />
                  </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="Fore" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
              </Storyboard>
              <Storyboard x:Key="TwinkleStoryboard" FillBehavior="Stop">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Fore" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                  <LinearDoubleKeyFrame KeyTime="0:0:0.1" Value="1.1" />
                  <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="1.0" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Fore" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)">
                  <LinearDoubleKeyFrame KeyTime="0:0:0.1" Value="1.1" />
                  <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="1.0" />
                </DoubleAnimationUsingKeyFrames>
              </Storyboard>
            </ResourceDictionary>
          </FrameworkTemplate.Resources>
          <ControlTemplate.Triggers>
            <Trigger Property="wn:ContentDialog.IsDisplaying" Value="True">
              <TriggerBase.EnterActions>
                <BeginStoryboard Storyboard="{StaticResource LoadStoryboard}" />
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard Storyboard="{StaticResource UnloadStoryboard}" />
              </TriggerBase.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
          <Grid Name="Root">
            <Rectangle Name="Back" Fill="#00FFFFFF" Visibility="{Binding IsModel, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}">
              <FrameworkElement.Triggers>
                <EventTrigger RoutedEvent="MouseDown">
                  <BeginStoryboard Storyboard="{StaticResource TwinkleStoryboard}" />
                </EventTrigger>
              </FrameworkElement.Triggers>
            </Rectangle>
            <Border Name="Fore" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5 0.5">
              <UIElement.RenderTransform>
                <TransformGroup>
                  <ScaleTransform />
                  <TranslateTransform />
                </TransformGroup>
              </UIElement.RenderTransform>
              <Border Name="Main" ClipToBounds="True" SnapsToDevicePixels="True" UseLayoutRounding="True">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                  </Grid.RowDefinitions>
                  <FrameworkElement.MinWidth>
                    <MultiBinding Converter="{StaticResource MinMultiValueConverter}">
                      <Binding Path="DialogWidth" Mode="OneWay" RelativeSource="{RelativeSource TemplatedParent}" />
                      <Binding Path="ActualWidth" Mode="OneWay" RelativeSource="{RelativeSource TemplatedParent}" />
                    </MultiBinding>
                  </FrameworkElement.MinWidth>
                  <FrameworkElement.MinHeight>
                    <MultiBinding Converter="{StaticResource MinMultiValueConverter}">
                      <Binding Path="DialogHeight" Mode="OneWay" RelativeSource="{RelativeSource TemplatedParent}" />
                      <Binding Path="ActualHeight" Mode="OneWay" RelativeSource="{RelativeSource TemplatedParent}" />
                    </MultiBinding>
                  </FrameworkElement.MinHeight>
                  <Border Grid.Row="0" Grid.RowSpan="2" Padding="{TemplateBinding Control.Padding}" BorderThickness="{TemplateBinding Control.BorderThickness}" BorderBrush="{TemplateBinding Control.BorderBrush}" Background="{TemplateBinding Control.Background}" SnapsToDevicePixels="True">
                    <wx:ContentDialogDragging.Dragging>
                      <wx:ContentDialogDragging ContainerName="Root" TargetName="Fore" />
                    </wx:ContentDialogDragging.Dragging>
                  </Border>
                  <ContentPresenter Grid.Row="0" Grid.RowSpan="2" Content="{TemplateBinding ContentControl.Content}" />
                </Grid>
              </Border>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>