<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:Cvte.Paint.Framework">
  <Style x:Key="{x:Type p:Slide}" TargetType="{x:Type p:Slide}">
    <Setter Property="Background" Value="#FFFFFFFF" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type p:Slide}">
          <Border SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" Background="{Binding Path=(p:SlideStyle.BaseBackground), RelativeSource={RelativeSource TemplatedParent}}">
            <AdornerDecorator>
              <Grid Background="{TemplateBinding Control.Background}">
                <ContentPresenter Name="PART_ContentHost" />
                <Canvas>
                  <ContentPresenter Name="PART_UtilitiesHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsManipulationEnabled="False" />
                </Canvas>
                <Border BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" />
              </Grid>
            </AdornerDecorator>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>