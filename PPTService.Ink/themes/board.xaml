<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:paint="clr-namespace:Cvte.Paint.Framework" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="{x:Type paint:Board}" TargetType="{x:Type paint:Board}">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False" />
    <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
    <Setter Property="Stylus.IsTapFeedbackEnabled" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type paint:Board}">
          <AdornerDecorator>
            <paint:BoardEventSource x:Name="PART_DecoratorSource" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}">
              <Grid Margin="{TemplateBinding Control.Padding}">
                <paint:SlideViewbox x:Name="PART_SlideViewBox">
                  <ContentPresenter Name="PART_ContentHost" Content="{Binding CurrentSlide, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                </paint:SlideViewbox>
              </Grid>
              <Grid Name="PART_UtilitiesGrid" />
            </paint:BoardEventSource>
          </AdornerDecorator>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>