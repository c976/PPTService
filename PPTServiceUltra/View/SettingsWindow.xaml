<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PPTServiceUltra.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" WindowStyle="None" AllowsTransparency="True"
        Background="{DynamicResource Theme.MaskBackground}"
        Foreground="{DynamicResource Theme.SettingsForeground}"
        WindowState="Maximized" Topmost="True" ResizeMode="NoResize" Focusable="True"
        FontFamily="微软雅黑">
  <!-- 原生按钮 / 下拉框 / 复选框的背景与边框保持系统默认配色；
       只把文字前景接到主题，保证深色下可读。所有改动即时生效，无需确定 / 应用。 -->
  <Grid>
    <!-- 高度按内容自适应：固定 612 时底部会留一大片空白；上限 740 保证不超过 768 屏。 -->
    <Border Width="480" Height="Auto" MaxHeight="740" Background="{DynamicResource Theme.SettingsBackground}" CornerRadius="10"
            BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"
            HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True">
      <Grid Margin="14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,6">
          <TextBlock Text="设置" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
          <TextBlock Name="VersionTextBlock" FontSize="12" Foreground="{DynamicResource Theme.SettingsMutedText}" DockPanel.Dock="Right" VerticalAlignment="Center" />
        </DockPanel>

        <GroupBox Grid.Row="1" Header="功能栏按钮（勾选显示，拖动或 ▲▼ 排序）" Margin="0,0,0,6"
                  Foreground="{DynamicResource Theme.SettingsForeground}">
          <ListBox Name="ToolbarListBox" Height="126" Margin="4" BorderThickness="0" Background="Transparent"
                   ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.PanningMode="None"
                   AllowDrop="True"
                   PreviewMouseLeftButtonDown="ToolbarListBox_PreviewMouseLeftButtonDown"
                   PreviewMouseMove="ToolbarListBox_PreviewMouseMove"
                   Drop="ToolbarListBox_Drop"
                   DragOver="ToolbarListBox_DragOver"
                   PreviewTouchDown="ToolbarListBox_PreviewTouchDown"
                   PreviewTouchMove="ToolbarListBox_PreviewTouchMove"
                   PreviewTouchUp="ToolbarListBox_PreviewTouchUp">
            <ListBox.ItemContainerStyle>
              <Style TargetType="{x:Type ListBoxItem}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="23" />
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <CheckBox Grid.Column="0" IsChecked="{Binding IsVisible, Mode=TwoWay}" VerticalAlignment="Center"
                            Foreground="{DynamicResource Theme.SettingsForeground}" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="6,0"
                             Foreground="{DynamicResource Theme.SettingsForeground}" />
                  <Button Grid.Column="2" Content="▲" Width="26" Height="20" Padding="0" Margin="2,0" Click="MoveUp_Click" Tag="{Binding}" />
                  <Button Grid.Column="3" Content="▼" Width="26" Height="20" Padding="0" Margin="2,0" Click="MoveDown_Click" Tag="{Binding}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="批注方式" Margin="0,0,0,6"
                  Foreground="{DynamicResource Theme.SettingsForeground}">
          <StackPanel Margin="4">
            <CheckBox Name="EnableSelfAnnotationCheckBox"
                      Content="启用自实现批注功能" Margin="2"
                      Foreground="{DynamicResource Theme.SettingsForeground}" />
            <TextBlock Text="不勾选时使用 Office / WPS 原生批注"
                       Margin="20,2,2,2" FontSize="11" Foreground="{DynamicResource Theme.SettingsMutedText}" TextWrapping="Wrap" />
            <CheckBox Name="LegacyTopmostWindowCheckBox"
                      Content="批注窗口附着PPT放映窗口" Margin="2,8,2,2"
                      Foreground="{DynamicResource Theme.SettingsForeground}" />
            <TextBlock Text="关闭后批注窗口将处于全局置顶模式，可能遮挡其它程序，无法在PPT放映时打开其他程序。仅当PPT放映无法正常出现工具栏时才建议关闭。"
                       Margin="20,2,2,2" FontSize="11" Foreground="{DynamicResource Theme.SettingsMutedText}" TextWrapping="Wrap" />
          </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="其它功能" Margin="0,0,0,6"
                  Foreground="{DynamicResource Theme.SettingsForeground}">
          <StackPanel Margin="4">
            <CheckBox Name="QrCodeCheckBox" Content="显示分享（创建二维码）按钮" Margin="2"
                      Foreground="{DynamicResource Theme.SettingsForeground}" />
            <CheckBox Name="ShowCollapseButtonCheckBox" Content="显示收起工具栏按钮" Margin="2"
                      Foreground="{DynamicResource Theme.SettingsForeground}" />
            <CheckBox Name="ShowLoadingCheckBox" Content="显示加载进度条界面" Margin="2"
                      Foreground="{DynamicResource Theme.SettingsForeground}" />
            <CheckBox Name="HideFunctionBarCheckBox" Content="隐藏功能栏" Margin="2"
                      Foreground="{DynamicResource Theme.SettingsForeground}" />
          </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="4" Header="外观" Margin="0,0,0,6"
                  Foreground="{DynamicResource Theme.SettingsForeground}">
          <Grid Margin="4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="界面主题：" VerticalAlignment="Center" Margin="2,3,8,3"
                       Foreground="{DynamicResource Theme.SettingsForeground}" />
            <ComboBox Name="ThemeComboBox" Grid.Row="0" Grid.Column="1" Margin="2,2">
              <ComboBoxItem Content="浅色" Tag="Light" />
              <ComboBoxItem Content="深色" Tag="Dark" />
              <ComboBoxItem Content="跟随系统" Tag="System" />
            </ComboBox>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="翻页按钮位置：" VerticalAlignment="Center" Margin="2,3,8,3"
                       Foreground="{DynamicResource Theme.SettingsForeground}" />
            <ComboBox Name="PageTurningPositionComboBox" Grid.Row="1" Grid.Column="1" Margin="2,2">
              <ComboBoxItem Content="默认（WPS 侧边 / Office 底部）" Tag="Default" />
              <ComboBoxItem Content="底部" Tag="Bottom" />
              <ComboBoxItem Content="侧边" Tag="Both" />
              <ComboBoxItem Content="不显示" Tag="None" />
            </ComboBox>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="工具栏透明度：" VerticalAlignment="Center" Margin="2,3,8,3"
                       Foreground="{DynamicResource Theme.SettingsForeground}" />
            <Grid Grid.Row="2" Grid.Column="1" Margin="2,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <!-- 触控：默认 Slider 必须精确按在 Thumb 上才能拖，手指很难命中；
                   整条轨道捕获触摸后按触点位置直接换算 Value（见代码后置）。
                   IsMoveToPointEnabled 让鼠标点击轨道任意位置也能直接跳转。 -->
              <Slider Name="ToolbarOpacitySlider" Grid.Column="0" Minimum="20" Maximum="100"
                      SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True"
                      IsMoveToPointEnabled="True" Value="70" VerticalAlignment="Center" Margin="0,0,8,0"
                      ValueChanged="ToolbarOpacitySlider_ValueChanged"
                      PreviewTouchDown="ToolbarOpacitySlider_PreviewTouchDown"
                      PreviewTouchMove="ToolbarOpacitySlider_PreviewTouchMove"
                      PreviewTouchUp="ToolbarOpacitySlider_PreviewTouchUp" />
              <TextBlock Name="ToolbarOpacityValueTextBlock" Grid.Column="1" Width="38" Text="70%"
                         VerticalAlignment="Center" HorizontalAlignment="Right"
                         Foreground="{DynamicResource Theme.SettingsForeground}" />
            </Grid>
            <CheckBox Name="AutoFadePageButtonsCheckBox" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                      Content="翻页按钮自动淡化" Margin="2,5,2,2"
                      Foreground="{DynamicResource Theme.SettingsForeground}" />
          </Grid>
        </GroupBox>

        <Grid Grid.Row="5" Margin="0,0,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Name="ResetButton" Grid.Column="0" Content="恢复默认" Width="80" Margin="0,0,8,0" HorizontalAlignment="Left" Click="Reset_Click" />
          <Button Name="CloseButton" Grid.Column="1" Content="关闭" Width="90" Click="Close_Click" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
