  <!-- 版本号 / git 短 hash / NSIS 版本头文件统一由 Version\Version.targets 生成。
       本文件所在的 PPTServiceUltra 项目是版本所有者：负责写 Version\Version.nsh，
       并在构建成功后把 Version\build.ver +1 供下一次构建使用。 -->
  <PropertyGroup>
    <IsVersionOwner>true</IsVersionOwner>
  </PropertyGroup>
  <!-- Optional plugins are built via ProjectReference but not assembly-referenced;
       copy them explicitly so NSIS payload (bin\Release\*.*) includes them. -->
  <Target Name="CopyOptionalPlugins" AfterTargets="Build">
    <Copy SourceFiles="..\PPTServiceUltra.Ink.Hardware\bin\$(Configuration)\PPTServiceUltra.Ink.Hardware.dll"
          DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true"
          Condition="Exists('..\PPTServiceUltra.Ink.Hardware\bin\$(Configuration)\PPTServiceUltra.Ink.Hardware.dll')" />
    <Copy SourceFiles="..\PPTServiceUltra.Ink.Hardware.Core\bin\$(Configuration)\PPTServiceUltra.Ink.Hardware.Core.dll"
          DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true"
          Condition="Exists('..\PPTServiceUltra.Ink.Hardware.Core\bin\$(Configuration)\PPTServiceUltra.Ink.Hardware.Core.dll')" />
    <Copy SourceFiles="..\PPTServiceUltra.NetShared\bin\$(Configuration)\PPTServiceUltra.NetShared.dll"
          DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true"
          Condition="Exists('..\PPTServiceUltra.NetShared\bin\$(Configuration)\PPTServiceUltra.NetShared.dll')" />
    <Copy SourceFiles="..\PPTServiceUltra.Hardware\bin\$(Configuration)\PPTServiceUltra.Hardware.dll"
          DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true"
          Condition="Exists('..\PPTServiceUltra.Hardware\bin\$(Configuration)\PPTServiceUltra.Hardware.dll')" />
  </Target>
