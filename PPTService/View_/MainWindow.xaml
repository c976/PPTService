      </Storyboard>
      <Storyboard x:Key="HiddenLeftCenterButtonGridStoryBoard">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LeftCenterButtonGrid" Storyboard.TargetProperty="Opacity">
