          <EasingDoubleKeyFrame KeyTime="0:0:6" Value="1" />
          <EasingDoubleKeyFrame KeyTime="0:0:7" Value="0.3" />
        </DoubleAnimationUsingKeyFrames>
      </Storyboard>
      <!-- 收起/拉起工具栏：只动画中心工具栏容器，翻页按钮在其它 Grid 中不受影响。 -->
      <ControlTemplate x:Key="ToolbarPullupButtonTemplate" TargetType="{x:Type Button}">
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
      </ControlTemplate>
      <Storyboard x:Key="HideToolbarStoryboard">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BottomCenterButtonGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" Completed="HideToolbarStoryboard_OnCompleted">
          <EasingDoubleKeyFrame KeyTime="0" Value="0" />
          <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="70">
            <EasingDoubleKeyFrame.EasingFunction>
              <CircleEase EasingMode="EaseIn" />
            </EasingDoubleKeyFrame.EasingFunction>
          </EasingDoubleKeyFrame>
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BottomCenterButtonGrid" Storyboard.TargetProperty="Opacity">
          <EasingDoubleKeyFrame KeyTime="0" Value="1" />
          <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="0" />
        </DoubleAnimationUsingKeyFrames>
      </Storyboard>
      <Storyboard x:Key="ShowToolbarStoryboard">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BottomCenterButtonGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" Completed="ShowToolbarStoryboard_OnCompleted">
          <EasingDoubleKeyFrame KeyTime="0" Value="70" />
          <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="0">
            <EasingDoubleKeyFrame.EasingFunction>
              <CircleEase EasingMode="EaseOut" />
            </EasingDoubleKeyFrame.EasingFunction>
          </EasingDoubleKeyFrame>
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BottomCenterButtonGrid" Storyboard.TargetProperty="Opacity">
          <EasingDoubleKeyFrame KeyTime="0" Value="0" />
          <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="1" />
        </DoubleAnimationUsingKeyFrames>
      </Storyboard>
      <!-- 拉起按钮只做淡入淡出，不做 Y 位移，保证始终紧贴屏幕底边。 -->
      <Storyboard x:Key="ShowToolbarPullupStoryboard">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PullupButton" Storyboard.TargetProperty="Opacity">
          <EasingDoubleKeyFrame KeyTime="0" Value="0" />
          <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1" />
        </DoubleAnimationUsingKeyFrames>
      </Storyboard>
      <Storyboard x:Key="HideToolbarPullupStoryboard">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PullupButton" Storyboard.TargetProperty="Opacity" Completed="HideToolbarPullupStoryboard_OnCompleted">
          <EasingDoubleKeyFrame KeyTime="0" Value="1" />
          <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="0" />
        </DoubleAnimationUsingKeyFrames>
      </Storyboard>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <!-- 外层铺满整个窗口（无 Margin）：批注绘制层放这里才能真正全屏；
       RootGrid 只承载工具栏按钮，保留原有留白 Margin。 -->
  <Grid Name="WindowRootGrid">
    <!-- 自实现批注绘制层：与窗口等大，位于工具栏之下。 -->
    <Border Name="AnnotationHost" />
    <Grid Name="RootGrid" FocusManager.IsFocusScope="True" Margin="6 1 6 6">
      <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition />
      <ColumnDefinition />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="AdaptiveStates">
        <VisualState x:Name="Adaptive0">
          <Storyboard>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Margin">
              <DiscreteObjectKeyFrame KeyTime="0">
                <ObjectKeyFrame.Value>
                  <Thickness>3 1 3 3</Thickness>
                </ObjectKeyFrame.Value>
              </DiscreteObjectKeyFrame>
            </ObjectAnimationUsingKeyFrames>
            <!-- 拉起按钮：1366 下高度为工具栏(30)的一半，图标尺寸同板中板收起按钮。 -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PullupBorder" Storyboard.TargetProperty="(FrameworkElement.Width)">
              <EasingDoubleKeyFrame KeyTime="0" Value="30" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PullupBorder" Storyboard.TargetProperty="(FrameworkElement.Height)">
              <EasingDoubleKeyFrame KeyTime="0" Value="15" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PullupChevron" Storyboard.TargetProperty="(FrameworkElement.Height)">
              <EasingDoubleKeyFrame KeyTime="0" Value="7" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LeftSlideManagerViewGrid" Storyboard.TargetProperty="(FrameworkElement.Width)">
              <EasingDoubleKeyFrame KeyTime="0" Value="90" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LeftSlideManagerViewGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.X)">
              <EasingDoubleKeyFrame KeyTime="0" Value="40" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RightSlideManagerViewGrid" Storyboard.TargetProperty="(FrameworkElement.Width)">
              <EasingDoubleKeyFrame KeyTime="0" Value="90" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RightSlideManagerViewGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.X)">
              <EasingDoubleKeyFrame KeyTime="0" Value="-40" />
            </DoubleAnimationUsingKeyFrames>
          </Storyboard>
        </VisualState>
        <VisualState x:Name="Adaptive1440" />
        <VisualState x:Name="Adaptive3800">
          <Storyboard>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Margin">
              <DiscreteObjectKeyFrame KeyTime="0">
                <ObjectKeyFrame.Value>
                  <Thickness>12 1 12 12</Thickness>
                </ObjectKeyFrame.Value>
              </DiscreteObjectKeyFrame>
            </ObjectAnimationUsingKeyFrames>
            <!-- 4K 100%：工具栏高 100，拉起按钮高 50，图标高 20（同板中板收起按钮）。 -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PullupBorder" Storyboard.TargetProperty="(FrameworkElement.Width)">
              <EasingDoubleKeyFrame KeyTime="0" Value="100" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PullupBorder" Storyboard.TargetProperty="(FrameworkElement.Height)">
              <EasingDoubleKeyFrame KeyTime="0" Value="50" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PullupChevron" Storyboard.TargetProperty="(FrameworkElement.Height)">
              <EasingDoubleKeyFrame KeyTime="0" Value="20" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LeftSlideManagerViewGrid" Storyboard.TargetProperty="(FrameworkElement.Width)">
              <EasingDoubleKeyFrame KeyTime="0" Value="310" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LeftSlideManagerViewGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.X)">
              <EasingDoubleKeyFrame KeyTime="0" Value="110" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RightSlideManagerViewGrid" Storyboard.TargetProperty="(FrameworkElement.Width)">
              <EasingDoubleKeyFrame KeyTime="0" Value="310" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RightSlideManagerViewGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.X)">
              <EasingDoubleKeyFrame KeyTime="0" Value="-110" />
            </DoubleAnimationUsingKeyFrames>
          </Storyboard>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <i:Interaction.Triggers>
      <pptService:AdaptiveTrigger MinWindowWidth="0">
        <core:GoToStateAction xmlns:core="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" StateName="Adaptive0" />
      </pptService:AdaptiveTrigger>
      <pptService:AdaptiveTrigger MinWindowWidth="1440">
        <GoToStateAction StateName="Adaptive1440" xmlns="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" />
      </pptService:AdaptiveTrigger>
      <pptService:AdaptiveTrigger MinWindowWidth="3800">
        <GoToStateAction StateName="Adaptive3800" xmlns="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" />
      </pptService:AdaptiveTrigger>
    </i:Interaction.Triggers>
    <Grid Name="LeftCenterButtonGrid" Row="0" RowSpan="2" Column="0" HorizontalAlignment="Left" />
    <Grid Name="RightCenterButtonGrid" Row="0" RowSpan="2" Column="2" HorizontalAlignment="Right" />
    <Grid Name="LeftBottomButtonGrid" Row="1" Column="0" HorizontalAlignment="Left" />
    <Grid Name="RightBottomButtonGrid" Row="1" Column="2" HorizontalAlignment="Right" />
    <Button Name="LowMaskButton" Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="3" Visibility="Collapsed" Style="{StaticResource NoButtonStyle}" PreviewMouseLeftButtonDown="LowMaskButton_Click" />
    <Grid Name="BottomCenterButtonGrid" Row="1" Column="0" ColumnSpan="3" HorizontalAlignment="Center">
      <Grid.RenderTransform>
        <TranslateTransform Y="0" />
      </Grid.RenderTransform>
    </Grid>
    <Button Name="HighMaskButton" Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="3" Visibility="Collapsed" Style="{StaticResource NoButtonStyle}" PreviewMouseLeftButtonDown="HighMaskButton_Click" />
    <Grid Name="LeftSlideManagerViewGrid" Row="0" Column="0" RowSpan="2" Width="160" Margin="0 10 0 10" HorizontalAlignment="Left" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1">
      <UIElement.RenderTransform>
        <TransformGroup>
          <ScaleTransform ScaleX="0" ScaleY="0" />
        </TransformGroup>
      </UIElement.RenderTransform>
      <ListBox Name="LeftSlideListBox" ItemsSource="{Binding SlideItems}" />
    </Grid>
    <Grid Name="RightSlideManagerViewGrid" Row="0" Column="2" RowSpan="2" Width="160" Margin="0 10 0 10" HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="1,0.5">
      <UIElement.RenderTransform>
        <TransformGroup>
          <ScaleTransform ScaleX="0" ScaleY="0" />
        </TransformGroup>
      </UIElement.RenderTransform>
      <ListBox Name="RightSlideListBox" ItemsSource="{Binding SlideItems}" />
    </Grid>
    <Grid Name="QrGrid" Row="0" Column="0" RowSpan="2" ColumnSpan="3" Visibility="Collapsed" Background="#27000000" MouseLeftButtonDown="QrGrid_OnMouseLeftButtonDown">
      <Border Width="700" Height="700" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Image Name="QrImage" Width="700" Height="700" Visibility="Collapsed" />
      </Border>
    </Grid>
  </Grid>
    <!-- 工具栏收起后的拉起按钮：必须放在无 Margin、无行列的 WindowRootGrid 里，
         并显式指定 Grid.Row/Column 之外不要落在 RootGrid 的 Row0/Column0（否则会贴到
         翻页按钮上方、第一列居中的错误位置）。这里相对整个窗口贴底边、水平居中。 -->
    <Button Name="PullupButton" Visibility="Collapsed" Opacity="0"
            Template="{StaticResource ToolbarPullupButtonTemplate}" Panel.ZIndex="10"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0" Padding="0"
            Focusable="False" Click="PullupToolbar_OnClick">
      <Border Name="PullupBorder" Width="50" Height="25" CornerRadius="4,4,0,0"
              Background="{DynamicResource Theme.PanelBackground}" BorderBrush="{DynamicResource Theme.BorderBrush}"
              BorderThickness="1,1,1,0" SnapsToDevicePixels="True">
        <Path Name="PullupChevron" Data="M0,6 L6,0 L12,6" Stroke="{DynamicResource Theme.IconBrush}"
              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform"
              Width="12" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
    </Button>
  </Grid>
</Window>