<Window x:Class="PPTService.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" WindowStyle="None" AllowsTransparency="True"
        Background="#66000000" WindowState="Maximized" Topmost="True" ResizeMode="NoResize"
        FontFamily="微软雅黑">
  <Grid>
    <Border Width="460" Height="580" Background="White" CornerRadius="10" BorderBrush="#D0D0D0" BorderThickness="1"
            HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True">
      <Grid Margin="16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
          <TextBlock Text="设置" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
          <TextBlock Name="VersionTextBlock" FontSize="12" Foreground="Gray" DockPanel.Dock="Right" VerticalAlignment="Center" />
        </DockPanel>

        <GroupBox Grid.Row="1" Header="工具栏按钮（勾选显示，可拖动或 ▲▼ 调整顺序）" Margin="0,0,0,8">
          <ListBox Name="ToolbarListBox" Margin="4" BorderThickness="0" Background="Transparent"
                   AllowDrop="True"
                   PreviewMouseLeftButtonDown="ToolbarListBox_PreviewMouseLeftButtonDown"
                   PreviewMouseMove="ToolbarListBox_PreviewMouseMove"
                   Drop="ToolbarListBox_Drop"
                   DragOver="ToolbarListBox_DragOver">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <CheckBox Grid.Column="0" IsChecked="{Binding IsVisible, Mode=TwoWay}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="6,0" />
                  <Button Grid.Column="2" Content="▲" Width="30" Margin="2,0" Click="MoveUp_Click" Tag="{Binding}" />
                  <Button Grid.Column="3" Content="▼" Width="30" Margin="2,0" Click="MoveDown_Click" Tag="{Binding}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="批注方式" Margin="0,0,0,8">
          <StackPanel Margin="4">
            <RadioButton Name="RbOfficeAnno" GroupName="AnnoMode" Content="Office 原生批注（由 PowerPoint/WPS 自身提供）" Margin="2" />
            <RadioButton Name="RbSelfAnno" GroupName="AnnoMode" Content="自实现批注（桌面批注原版白板：压感笔迹、手势橡皮、翻页同步，希沃设备推荐）" Margin="2" />
          </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="其它功能" Margin="0,0,0,8">
          <CheckBox Name="QrCodeCheckBox" Content="显示「创建二维码（分享）」按钮" Margin="4" />
        </GroupBox>

        <GroupBox Grid.Row="4" Header="翻页按钮位置" Margin="0,0,0,8">
          <StackPanel Margin="4">
            <RadioButton Name="RbDefault" GroupName="PagePos" Content="默认（按程序原逻辑：WPS 两边 / Office 底部）" Margin="2" />
            <RadioButton Name="RbBottom" GroupName="PagePos" Content="底部（左右下角）" Margin="2" />
            <RadioButton Name="RbBoth" GroupName="PagePos" Content="两边（左右居中）" Margin="2" />
          </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
          <Button Name="ResetButton" Content="恢复默认" Width="80" Margin="0,0,8,0" Click="Reset_Click" />
          <Button Name="ApplyButton" Content="应用" Width="70" Margin="0,0,8,0" Click="Apply_Click" />
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Name="OkButton" Content="确定" Width="70" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click" />
          <Button Name="CancelButton" Content="取消" Width="70" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
