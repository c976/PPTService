<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PPTService.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" WindowStyle="None" AllowsTransparency="True"
        Background="{DynamicResource Theme.MaskBackground}"
        Foreground="{DynamicResource Theme.SettingsForeground}"
        WindowState="Maximized" Topmost="True" ResizeMode="NoResize"
        FontFamily="微软雅黑">
  <Window.Resources>
    <Style TargetType="{x:Type GroupBox}">
      <Setter Property="Foreground" Value="{DynamicResource Theme.SettingsForeground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderBrush}" />
    </Style>
    <Style TargetType="{x:Type TextBlock}">
      <Setter Property="Foreground" Value="{DynamicResource Theme.SettingsForeground}" />
    </Style>
    <Style TargetType="{x:Type CheckBox}">
      <Setter Property="Foreground" Value="{DynamicResource Theme.SettingsForeground}" />
    </Style>
    <Style TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="{DynamicResource Theme.SettingsForeground}" />
      <Setter Property="Background" Value="{DynamicResource Theme.SettingsControl}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderBrush}" />
    </Style>
    <Style TargetType="{x:Type ComboBox}">
      <Setter Property="Foreground" Value="{DynamicResource Theme.SettingsForeground}" />
      <Setter Property="Background" Value="{DynamicResource Theme.SettingsControl}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderBrush}" />
    </Style>
    <Style TargetType="{x:Type ComboBoxItem}">
      <Setter Property="Foreground" Value="{DynamicResource Theme.SettingsForeground}" />
      <Setter Property="Background" Value="{DynamicResource Theme.SettingsControl}" />
    </Style>
    <Style TargetType="{x:Type ListBox}">
      <Setter Property="Foreground" Value="{DynamicResource Theme.SettingsForeground}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </Window.Resources>
  <Grid>
    <Border Width="480" Height="680" Background="{DynamicResource Theme.SettingsBackground}" CornerRadius="10"
            BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1"
            HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True">
      <Grid Margin="16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
          <TextBlock Text="设置" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
          <TextBlock Name="VersionTextBlock" FontSize="12" Foreground="{DynamicResource Theme.SettingsMutedText}" DockPanel.Dock="Right" VerticalAlignment="Center" />
        </DockPanel>

        <GroupBox Grid.Row="1" Header="工具栏按钮（勾选显示，可拖动或使用 ▲▼ 调整顺序）" Margin="0,0,0,8">
          <ListBox Name="ToolbarListBox" Margin="4" BorderThickness="0" Background="Transparent"
                   AllowDrop="True"
                   PreviewMouseLeftButtonDown="ToolbarListBox_PreviewMouseLeftButtonDown"
                   PreviewMouseMove="ToolbarListBox_PreviewMouseMove"
                   Drop="ToolbarListBox_Drop"
                   DragOver="ToolbarListBox_DragOver">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <CheckBox Grid.Column="0" IsChecked="{Binding IsVisible, Mode=TwoWay}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="6,0" />
                  <Button Grid.Column="2" Content="▲" Width="30" Margin="2,0" Click="MoveUp_Click" Tag="{Binding}" />
                  <Button Grid.Column="3" Content="▼" Width="30" Margin="2,0" Click="MoveDown_Click" Tag="{Binding}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="批注方式" Margin="0,0,0,8">
          <StackPanel Margin="4">
            <CheckBox Name="EnableSelfAnnotationCheckBox"
                      Content="启用自实现批注功能"
                      Margin="2" />
            <TextBlock Text="不勾选时使用 Office / WPS 原生批注"
                       Margin="20,4,2,2" FontSize="11" Foreground="{DynamicResource Theme.SettingsMutedText}" TextWrapping="Wrap" />
          </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="其它功能" Margin="0,0,0,8">
          <StackPanel Margin="4">
            <CheckBox Name="QrCodeCheckBox" Content="显示分享（创建二维码）按钮" Margin="2" />
            <CheckBox Name="ShowLoadingCheckBox" Content="显示加载进度条界面" Margin="2" />
            <CheckBox Name="HideFunctionBarCheckBox" Content="隐藏功能栏（笔 / 橡皮 / 板中板等按钮区域）" Margin="2" />
          </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="4" Header="外观" Margin="0,0,0,8">
          <Grid Margin="4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="界面主题：" VerticalAlignment="Center" Margin="2,4,8,4" />
            <ComboBox Name="ThemeComboBox" Grid.Row="0" Grid.Column="1" Margin="2,3">
              <ComboBoxItem Content="浅色" Tag="Light" />
              <ComboBoxItem Content="深色" Tag="Dark" />
              <ComboBoxItem Content="跟随系统" Tag="System" />
            </ComboBox>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="翻页按钮位置：" VerticalAlignment="Center" Margin="2,4,8,4" />
            <ComboBox Name="PageTurningPositionComboBox" Grid.Row="1" Grid.Column="1" Margin="2,3">
              <ComboBoxItem Content="默认（WPS 侧边 / Office 底部）" Tag="Default" />
              <ComboBoxItem Content="底部" Tag="Bottom" />
              <ComboBoxItem Content="侧边" Tag="Both" />
              <ComboBoxItem Content="不显示" Tag="None" />
            </ComboBox>
            <CheckBox Name="PageTurningTranslucentCheckBox" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                      Content="翻页按钮半透明显示" Margin="2,6,2,2" />
          </Grid>
        </GroupBox>

        <Grid Grid.Row="5" Margin="0,0,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Name="ResetButton" Grid.Column="0" Content="恢复默认" Width="80" Margin="0,0,8,0" HorizontalAlignment="Left" Click="Reset_Click" />
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Name="OkButton" Content="确定" Width="70" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click" />
            <Button Name="CancelButton" Content="取消" Width="70" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" />
            <Button Name="ApplyButton" Content="应用" Width="70" Click="Apply_Click" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
