<Window x:Class="PPTService.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" WindowStyle="None" AllowsTransparency="True"
        Background="#66000000" WindowState="Maximized" Topmost="True" ResizeMode="NoResize"
        FontFamily="微软雅黑">
  <Grid>
    <Border Width="460" Height="580" Background="White" CornerRadius="10" BorderBrush="#D0D0D0" BorderThickness="1"
            HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True">
      <Grid Margin="16">
        <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
          <TextBlock Text="设置" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
          <TextBlock Name="VersionTextBlock" FontSize="12" Foreground="Gray" DockPanel.Dock="Right" VerticalAlignment="Center" />
        </DockPanel>

        <GroupBox Grid.Row="1" Header="工具栏按钮（勾选显示，可拖动或使用 ▲▼ 调整顺序）" Margin="0,0,0,8">
          <ListBox Name="ToolbarListBox" Margin="4" BorderThickness="0" Background="Transparent"
                   AllowDrop="True"
                   PreviewMouseLeftButtonDown="ToolbarListBox_PreviewMouseLeftButtonDown"
                   PreviewMouseMove="ToolbarListBox_PreviewMouseMove"
                   Drop="ToolbarListBox_Drop"
                   DragOver="ToolbarListBox_DragOver">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <CheckBox Grid.Column="0" IsChecked="{Binding IsVisible, Mode=TwoWay}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="6,0" />
                  <Button Grid.Column="2" Content="▲" Width="30" Margin="2,0" Click="MoveUp_Click" Tag="{Binding}" />
                  <Button Grid.Column="3" Content="▼" Width="30" Margin="2,0" Click="MoveDown_Click" Tag="{Binding}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="批注方式" Margin="0,0,0,8">
          <StackPanel Margin="4">
            <CheckBox Name="EnableSelfAnnotationCheckBox"
                      Content="启用自实现批注功能"
                      Margin="2" />
            <TextBlock Text="不勾选时使用 Office / WPS 原生批注"
                       Margin="20,4,2,2" FontSize="11" Foreground="Gray" TextWrapping="Wrap" />
          </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="其它功能" Margin="0,0,0,8">
          <StackPanel Margin="4">
            <CheckBox Name="QrCodeCheckBox" Content="显示分享（创建二维码）按钮" Margin="2" />
            <CheckBox Name="ShowLoadingCheckBox" Content="显示加载进度条界面" Margin="2" />
          </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="4" Header="翻页按钮位置" Margin="0,0,0,8">
          <StackPanel Margin="4">
            <RadioButton Name="RbDefault" GroupName="PagePos" Content="默认（WPS 侧边 / Office 底部）" Margin="2" />
            <RadioButton Name="RbBottom" GroupName="PagePos" Content="底部" Margin="2" />
            <RadioButton Name="RbBoth" GroupName="PagePos" Content="侧边" Margin="2" />
            <RadioButton Name="RbNone" GroupName="PagePos" Content="隐藏" Margin="2" />
          </StackPanel>
        </GroupBox>

        <Grid Grid.Row="5" Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Name="ResetButton" Grid.Column="0" Content="恢复默认" Width="80" Margin="0,0,8,0" HorizontalAlignment="Left" Click="Reset_Click" />
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Name="OkButton" Content="确定" Width="70" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click" />
            <Button Name="CancelButton" Content="取消" Width="70" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" />
            <Button Name="ApplyButton" Content="应用" Width="70" Click="Apply_Click" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
