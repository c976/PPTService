<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PPTService.BottomArea" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:pptService="clr-namespace:PPTService" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/PPTService;component/Images_/Images.xaml" />
        <ResourceDictionary Source="pack://application:,,,/PPTService;component/Style_/ButtonStyle.xaml" />
        <ResourceDictionary Source="pack://application:,,,/PPTService;component/Style_/CheckBoxStyle.xaml" />
        <ResourceDictionary Source="pack://application:,,,/PPTService;component/Style_/RadioButtonStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Storyboard x:Key="ShowColorDiskStoryBoard">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" Storyboard.TargetName="ColorDiskStoryBoardGrid">
          <EasingDoubleKeyFrame KeyTime="0" Value="0" />
          <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1">
            <EasingDoubleKeyFrame.EasingFunction>
              <BackEase Amplitude="0.2" />
            </EasingDoubleKeyFrame.EasingFunction>
          </EasingDoubleKeyFrame>
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" Storyboard.TargetName="ColorDiskStoryBoardGrid">
          <EasingDoubleKeyFrame KeyTime="0" Value="0" />
          <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1">
            <EasingDoubleKeyFrame.EasingFunction>
              <BackEase Amplitude="0.2" />
            </EasingDoubleKeyFrame.EasingFunction>
          </EasingDoubleKeyFrame>
        </DoubleAnimationUsingKeyFrames>
      </Storyboard>
      <!-- 橡皮「滑动清屏」滑杆（移植自桌面批注 DesktopEraserPopupBorder）：
           拖动到底（≥0.8）才清当前页，避免误触；松手后自动回弹。 -->
      <Style x:Key="EraserSliderStyle" TargetType="{x:Type Slider}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Slider}">
              <Border Name="RootBorder" CornerRadius="26" Width="200" Height="52" Background="#D4D4D4">
                <Grid Margin="5">
                  <TextBlock Text="滑动清屏" FontSize="16" Foreground="#989898" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0 0 14 0" IsHitTestVisible="False" />
                  <Track Name="PART_Track">
                    <Track.Thumb>
                      <Thumb Name="EraserThumb" Focusable="False" Width="42" Height="42">
                        <Thumb.Template>
                          <ControlTemplate TargetType="{x:Type Thumb}">
                            <Border CornerRadius="21" Background="White" BorderBrush="#B0B0B0" BorderThickness="1">
                              <Image Source="{StaticResource ImageSource.RubberNormal}" Width="22" Height="22" Stretch="Uniform" />
                            </Border>
                          </ControlTemplate>
                        </Thumb.Template>
                      </Thumb>
                    </Track.Thumb>
                  </Track>
                </Grid>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="RootGrid" Height="50">
    <UIElement.RenderTransform>
      <TranslateTransform Y="0" />
    </UIElement.RenderTransform>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="AdaptiveStates">
        <VisualState x:Name="Adaptive0">
          <Storyboard>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="(FrameworkElement.Height)">
              <EasingDoubleKeyFrame KeyTime="0" Value="30" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PlaceholderGrid" Storyboard.TargetProperty="(FrameworkElement.Width)">
              <EasingDoubleKeyFrame KeyTime="0" Value="2" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ExitGrid" Storyboard.TargetProperty="(FrameworkElement.Width)">
              <EasingDoubleKeyFrame KeyTime="0" Value="30" />
            </DoubleAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundBorder" Storyboard.TargetProperty="CornerRadius">
              <DiscreteObjectKeyFrame KeyTime="0">
                <ObjectKeyFrame.Value>
                  <CornerRadius>3</CornerRadius>
                </ObjectKeyFrame.Value>
              </DiscreteObjectKeyFrame>
            </ObjectAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LeftBackgroundBorder" Storyboard.TargetProperty="CornerRadius">
              <DiscreteObjectKeyFrame KeyTime="0">
                <ObjectKeyFrame.Value>
                  <CornerRadius>3</CornerRadius>
                </ObjectKeyFrame.Value>
              </DiscreteObjectKeyFrame>
            </ObjectAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ColorDiskPopup" Storyboard.TargetProperty="(FrameworkElement.Width)">
              <EasingDoubleKeyFrame KeyTime="0" Value="210" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ColorDiskPopup" Storyboard.TargetProperty="(FrameworkElement.Height)">
              <EasingDoubleKeyFrame KeyTime="0" Value="144" />
            </DoubleAnimationUsingKeyFrames>
          </Storyboard>
        </VisualState>
        <VisualState x:Name="Adaptive1440" />
        <VisualState x:Name="Adaptive3800">
          <Storyboard>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="(FrameworkElement.Height)">
              <EasingDoubleKeyFrame KeyTime="0" Value="100" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PlaceholderGrid" Storyboard.TargetProperty="(FrameworkElement.Width)">
              <EasingDoubleKeyFrame KeyTime="0" Value="8" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ExitGrid" Storyboard.TargetProperty="(FrameworkElement.Width)">
              <EasingDoubleKeyFrame KeyTime="0" Value="100" />
            </DoubleAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundBorder" Storyboard.TargetProperty="CornerRadius">
              <DiscreteObjectKeyFrame KeyTime="0">
                <ObjectKeyFrame.Value>
                  <CornerRadius>12</CornerRadius>
                </ObjectKeyFrame.Value>
              </DiscreteObjectKeyFrame>
            </ObjectAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LeftBackgroundBorder" Storyboard.TargetProperty="CornerRadius">
              <DiscreteObjectKeyFrame KeyTime="0">
                <ObjectKeyFrame.Value>
                  <CornerRadius>12</CornerRadius>
                </ObjectKeyFrame.Value>
              </DiscreteObjectKeyFrame>
            </ObjectAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ColorDiskPopup" Storyboard.TargetProperty="(FrameworkElement.Width)">
              <EasingDoubleKeyFrame KeyTime="0" Value="420" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ColorDiskPopup" Storyboard.TargetProperty="(FrameworkElement.Height)">
              <EasingDoubleKeyFrame KeyTime="0" Value="288" />
            </DoubleAnimationUsingKeyFrames>
          </Storyboard>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <i:Interaction.Triggers>
      <pptService:AdaptiveTrigger MinWindowWidth="0">
        <core:GoToStateAction xmlns:core="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" StateName="Adaptive0" />
      </pptService:AdaptiveTrigger>
      <pptService:AdaptiveTrigger MinWindowWidth="1440">
        <GoToStateAction StateName="Adaptive1440" xmlns="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" />
      </pptService:AdaptiveTrigger>
      <pptService:AdaptiveTrigger MinWindowWidth="3800">
        <GoToStateAction StateName="Adaptive3800" xmlns="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" />
      </pptService:AdaptiveTrigger>
    </i:Interaction.Triggers>
    <Grid Name="ShareGrid" Column="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="50" />
        <ColumnDefinition Width="50" />
      </Grid.ColumnDefinitions>
      <Border Name="LeftBackgroundBorder" Grid.ColumnSpan="2" CornerRadius="6" Background="#A0FFFFFF" BorderThickness="1" BorderBrush="#80666666" />
      <pptService:ImageButton x:Name="SettingsButton" Click="Settings_OnClick" Grid.Column="0" ToolTip="设置" NormalSource="{StaticResource ImageSource.SettingsNormal}" PressedSource="{StaticResource ImageSource.SettingsPressed}" />
      <pptService:ImageButton x:Name="ShareButton" Click="Share_OnClick" Grid.Column="1" NormalSource="{StaticResource ImageSource.ShareNormal}" PressedSource="{StaticResource ImageSource.SharePressed}" />
    </Grid>
    <Grid Column="1" Width="4" />
    <Grid Name="BottomCenterButtonGrid" Column="2" Background="#00FFFFFF" Focusable="False" HorizontalAlignment="Center">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="50" />
        <ColumnDefinition Width="50" />
        <ColumnDefinition Width="50" />
        <ColumnDefinition Width="50" />
        <ColumnDefinition Width="50" />
      </Grid.ColumnDefinitions>
      <Border Name="BackgroundBorder" Grid.ColumnSpan="6" CornerRadius="6" Background="#A0FFFFFF" BorderThickness="1" BorderBrush="#80666666" />
      <CheckBox Name="SelectCheckBox" Grid.Column="0" IsChecked="True" Style="{StaticResource CheckBoxStyle}" pptService:ControlHelper.NormalImage="{StaticResource ImageSource.SelectNormal}" pptService:ControlHelper.CheckedImage="{StaticResource ImageSource.SelectSelected}" Click="Select_OnClick" />
      <Button Name="PenButton" Grid.Column="1" Style="{StaticResource NormalButtonStyle}" Click="Pen_OnClick">
        <ContentControl.Content>
          <Grid>
            <Image Name="PenImage" Source="{StaticResource ImageSource.GrayPenNormal}" />
            <Image Name="SelectedPenImage" Visibility="Collapsed">
              <Image.Source>
                <DrawingImage>
                  <DrawingImage.Drawing>
                    <DrawingGroup>
                      <DrawingGroup.Children>
                        <GeometryDrawing>
                          <GeometryDrawing.Brush>
                            <SolidColorBrush Color="#FFD8D8D8" Opacity="0" />
                          </GeometryDrawing.Brush>
                          <GeometryDrawing.Geometry>
                            <PathGeometry FillRule="Nonzero" Figures="M31,31L32,31 32,32 31,32 31,31z M0,0L1,0 1,1 0,1 0,0z" />
                          </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <DrawingGroup Transform="0.707106781186547,0.707106781186548,-0.707106781186548,0.707106781186547,24.1629511554251,2.51522862093623E-07">
                          <DrawingGroup.Children>
                            <DrawingGroup>
                              <DrawingGroup.Children>
                                <GeometryDrawing Brush="{Binding PenBrush}">
                                  <GeometryDrawing.Geometry>
                                    <PathGeometry FillRule="Nonzero" Figures="M10.4,23L10.4,23 10.4,31.9 5.5,36.9 0.5,31.9 0.5,23z" />
                                  </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <DrawingGroup Opacity="0.4">
                                  <DrawingGroup.Children>
                                    <GeometryDrawing Brush="#FF000000">
                                      <GeometryDrawing.Geometry>
                                        <PathGeometry FillRule="Nonzero" Figures="M2.5,25L8.4,25 8.4,31.1 5.5,34 2.5,31 2.5,25 M0.5,23L0.6,31.9 5.5,36.8 10.4,31.9 10.4,23 0.5,23 0.5,23z" />
                                      </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                  </DrawingGroup.Children>
                                </DrawingGroup>
                              </DrawingGroup.Children>
                            </DrawingGroup>
                            <DrawingGroup>
                              <DrawingGroup.Children>
                                <GeometryDrawing Brush="#FF666666">
                                  <GeometryDrawing.Geometry>
                                    <PathGeometry FillRule="Nonzero" Figures="M1.4,20L1.3,3.7C1.3,3.2 1.5,2.7 1.9,2.3 2.3,1.9 2.8,1.7 3.3,1.7L7.3,1.7C8.4,1.7,9.3,2.6,9.3,3.7L9.4,20 1.4,20z" />
                                  </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing Brush="#FF666666">
                                  <GeometryDrawing.Geometry>
                                    <PathGeometry FillRule="Nonzero" Figures="M2.6,3C2.7,2.9,2.9,2.7,3.3,2.7L7.3,2.7C7.9,2.7,8.3,3.1,8.3,3.7L8.4,19 2.5,19 2.3,3.7C2.3,3.3,2.5,3.1,2.6,3 M1.2,1.6C0.6,2.1,0.3,2.9,0.3,3.7L0.4,21 10.3,21 10.3,3.7C10.3,2,8.9,0.7,7.3,0.7L3.3,0.7C2.4,0.7,1.7,1,1.2,1.6L1.2,1.6z" />
                                  </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                              </DrawingGroup.Children>
                            </DrawingGroup>
                          </DrawingGroup.Children>
                        </DrawingGroup>
                      </DrawingGroup.Children>
                    </DrawingGroup>
                  </DrawingImage.Drawing>
                </DrawingImage>
              </Image.Source>
            </Image>
          </Grid>
        </ContentControl.Content>
      </Button>
      <CheckBox Name="RubberCheckBox" Grid.Column="2" IsChecked="False" Style="{StaticResource CheckBoxStyle}" pptService:ControlHelper.NormalImage="{StaticResource ImageSource.RubberNormal}" pptService:ControlHelper.CheckedImage="{StaticResource ImageSource.RubberSelected}" Click="Rubber_OnClick" />
      <pptService:ImageButton x:Name="MagnifierButton" Click="Magnifier_Click" Grid.Column="3" NormalSource="{StaticResource ImageSource.MagnifierNormal}" PressedSource="{StaticResource ImageSource.MagnifierSelected}" />
      <CheckBox Name="InnerBoardCheckBox" Grid.Column="4" IsChecked="False" Style="{StaticResource CheckBoxStyle}" pptService:ControlHelper.NormalImage="{StaticResource ImageSource.PlateNormal}" pptService:ControlHelper.CheckedImage="{StaticResource ImageSource.PlateSelected}" Click="InnerBoard_Click" />
      <!-- 笔设置面板（移植自桌面批注 DesktopPenPopupBorder）：3 档粗细 + 9 色。
           内部固定 280x192，外层 Viewbox 按 Popup 尺寸等比缩放（210x144 / 280x192 / 420x288 同比例）。 -->
      <Popup Name="ColorDiskPopup" Grid.Column="0" Grid.ColumnSpan="4" Width="280" Height="192" StaysOpen="False" Placement="Top" AllowsTransparency="True" Opened="ColorDiskPopup_OnOpened">
        <Grid Background="#00FFFFFF">
          <Grid Name="ColorDiskStoryBoardGrid" RenderTransformOrigin="0.5,1">
            <UIElement.RenderTransform>
              <TransformGroup>
                <ScaleTransform ScaleX="0" ScaleY="0" />
              </TransformGroup>
            </UIElement.RenderTransform>
            <Viewbox Stretch="Fill">
              <Border Width="280" Height="192" Background="#E6FFFFFF" CornerRadius="4">
                <StackPanel Orientation="Horizontal">
                  <UniformGrid Name="ThicknessGrid" Rows="3" Columns="1" VerticalAlignment="Center" Margin="18 0 6 0">
                    <RadioButton Name="ThinRadioButton" Style="{StaticResource PenThicknessRadioButtonStyle}" Tag="{x:Static pptService:PenSettings.PenLightWeight}" Click="ThicknessRadioButton_OnClick">
                      <Ellipse Width="6" Height="6" Fill="#FF666666" />
                    </RadioButton>
                    <RadioButton Name="MediumRadioButton" Style="{StaticResource PenThicknessRadioButtonStyle}" Tag="{x:Static pptService:PenSettings.PenWeight}" Click="ThicknessRadioButton_OnClick" IsChecked="True">
                      <Ellipse Width="13" Height="13" Fill="#FF666666" />
                    </RadioButton>
                    <RadioButton Name="BoldRadioButton" Style="{StaticResource PenThicknessRadioButtonStyle}" Tag="{x:Static pptService:PenSettings.PenBoldWeight}" Click="ThicknessRadioButton_OnClick">
                      <Ellipse Width="21" Height="21" Fill="#FF666666" />
                    </RadioButton>
                  </UniformGrid>
                  <UniformGrid Name="ColorDiskGrid" Rows="3" Columns="3" Margin="6 10 14 10" VerticalAlignment="Center">
                    <RadioButton Background="#FFFF0000" Style="{StaticResource PenColorRadioButtonStyle}" Click="RadioButton_OnClick" />
                    <RadioButton Background="#FFFF8B00" Style="{StaticResource PenColorRadioButtonStyle}" Click="RadioButton_OnClick" />
                    <RadioButton Background="#FFFFD800" Style="{StaticResource PenColorRadioButtonStyle}" Click="RadioButton_OnClick" />
                    <RadioButton Background="#FF0085CD" Style="{StaticResource PenColorRadioButtonStyle}" Click="RadioButton_OnClick" />
                    <RadioButton Background="#FF306ED9" Style="{StaticResource PenColorRadioButtonStyle}" Click="RadioButton_OnClick" />
                    <RadioButton Background="#FF331EB5" Style="{StaticResource PenColorRadioButtonStyle}" Click="RadioButton_OnClick" />
                    <RadioButton Background="#FF306C01" Style="{StaticResource PenColorRadioButtonStyle}" Click="RadioButton_OnClick" />
                    <RadioButton Background="#FF66D552" Style="{StaticResource PenColorRadioButtonStyle}" Click="RadioButton_OnClick" />
                    <RadioButton Background="#FF000000" Style="{StaticResource PenColorRadioButtonStyle}" Click="RadioButton_OnClick" />
                  </UniformGrid>
                </StackPanel>
                <UIElement.Effect>
                  <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.15" />
                </UIElement.Effect>
              </Border>
            </Viewbox>
          </Grid>
        </Grid>
      </Popup>
      <!-- 橡皮已选中时再次点击橡皮弹出：滑到底（≥0.8）清当前页笔迹。 -->
      <Popup Name="EraserSliderPopup" Grid.Column="0" Grid.ColumnSpan="4" Width="230" Height="100" StaysOpen="True" Placement="Top" AllowsTransparency="True" Opened="EraserSliderPopup_OnOpened">
        <Border Width="230" Height="100" Background="#E6FFFFFF" CornerRadius="4">
          <Slider Name="EraserSlide" Maximum="1" Minimum="0" Value="0" Style="{StaticResource EraserSliderStyle}" Thumb.DragStarted="EraserSlide_DragStarted" Thumb.DragCompleted="EraserSlide_DragCompleted" />
          <UIElement.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.15" />
          </UIElement.Effect>
        </Border>
      </Popup>
    </Grid>
    <Grid Name="PlaceholderGrid" Column="3" Width="4" />
    <Grid Name="ExitGrid" Column="4" Width="50">
      <pptService:ImageButton Click="Exit_OnClick" Background="#A0FFFFFF" BorderThickness="1" NormalSource="{StaticResource ImageSource.ExitNormal}" PressedSource="{StaticResource ImageSource.ExitSelected}" />
    </Grid>
  </Grid>
</UserControl>