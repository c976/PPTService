<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:pptService="clr-namespace:PPTService" xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions">
  <Style x:Key="CheckBoxStyle" TargetType="{x:Type CheckBox}">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CheckBox}">
          <Grid Name="RootGrid" Background="{TemplateBinding Control.Background}" Focusable="False" FocusVisualStyle="{x:Null}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="AdaptiveStates">
                <VisualState x:Name="Adaptive0">
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentGrid" Storyboard.TargetProperty="Margin">
                      <DiscreteObjectKeyFrame KeyTime="0">
                        <ObjectKeyFrame.Value>
                          <Thickness>8</Thickness>
                        </ObjectKeyFrame.Value>
                      </DiscreteObjectKeyFrame>
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Adaptive1440" />
                <VisualState x:Name="Adaptive3800">
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentGrid" Storyboard.TargetProperty="Margin">
                      <DiscreteObjectKeyFrame KeyTime="0">
                        <ObjectKeyFrame.Value>
                          <Thickness>25</Thickness>
                        </ObjectKeyFrame.Value>
                      </DiscreteObjectKeyFrame>
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <i:Interaction.Triggers>
              <pptService:AdaptiveTrigger MinWindowWidth="0">
                <core:GoToStateAction xmlns:core="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" StateName="Adaptive0" />
              </pptService:AdaptiveTrigger>
              <pptService:AdaptiveTrigger MinWindowWidth="1440">
                <GoToStateAction StateName="Adaptive1440" xmlns="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" />
              </pptService:AdaptiveTrigger>
              <pptService:AdaptiveTrigger MinWindowWidth="3800">
                <GoToStateAction StateName="Adaptive3800" xmlns="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" />
              </pptService:AdaptiveTrigger>
            </i:Interaction.Triggers>
            <Grid Name="ContentGrid" Margin="11" Focusable="False" FocusVisualStyle="{x:Null}">
              <Image Name="NormalImage" Source="{TemplateBinding pptService:ControlHelper.NormalImage}" />
              <Image Name="CheckedImage" Source="{TemplateBinding pptService:ControlHelper.CheckedImage}" Visibility="Collapsed" />
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="NormalImage" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="CheckedImage" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Style.MagnifierCheckBox" TargetType="{x:Type CheckBox}">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CheckBox}">
          <Grid Name="RootGrid" Background="{TemplateBinding Control.Background}" Focusable="False" FocusVisualStyle="{x:Null}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="AdaptiveStates">
                <VisualState x:Name="Adaptive0">
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentGrid" Storyboard.TargetProperty="Margin">
                      <DiscreteObjectKeyFrame KeyTime="0">
                        <ObjectKeyFrame.Value>
                          <Thickness>2 2 2 0</Thickness>
                        </ObjectKeyFrame.Value>
                      </DiscreteObjectKeyFrame>
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Adaptive1440" />
                <VisualState x:Name="Adaptive3800">
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentGrid" Storyboard.TargetProperty="Margin">
                      <DiscreteObjectKeyFrame KeyTime="0">
                        <ObjectKeyFrame.Value>
                          <Thickness>8 8 8 0</Thickness>
                        </ObjectKeyFrame.Value>
                      </DiscreteObjectKeyFrame>
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <i:Interaction.Triggers>
              <pptService:AdaptiveTrigger MinWindowHeight="0">
                <GoToStateAction StateName="Adaptive0" xmlns="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" />
              </pptService:AdaptiveTrigger>
              <pptService:AdaptiveTrigger MinWindowHeight="770">
                <GoToStateAction StateName="Adaptive1440" xmlns="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" />
              </pptService:AdaptiveTrigger>
              <pptService:AdaptiveTrigger MinWindowHeight="2100">
                <GoToStateAction StateName="Adaptive3800" xmlns="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" />
              </pptService:AdaptiveTrigger>
            </i:Interaction.Triggers>
            <Grid Name="ContentGrid" Margin="4 4 4 0" Focusable="False" FocusVisualStyle="{x:Null}">
              <Image Name="NormalImage" Source="{TemplateBinding pptService:ControlHelper.NormalImage}" />
              <Image Name="CheckedImage" Source="{TemplateBinding pptService:ControlHelper.CheckedImage}" Visibility="Collapsed" />
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="NormalImage" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="CheckedImage" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>