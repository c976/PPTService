<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PPTService.Magnifier" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:pptService="clr-namespace:PPTService" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions" Left="0" Top="0" Background="#FF000000" Topmost="True" WindowStyle="None" ShowInTaskbar="False" ResizeMode="NoResize" SnapsToDevicePixels="True">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/PPTService;component/Style/ButtonStyle.xaml" />
        <ResourceDictionary Source="pack://application:,,,/PPTService;component/Style/EllipseStyle.xaml" />
        <ResourceDictionary Source="pack://application:,,,/PPTService;component/Style/CheckBoxStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Storyboard x:Key="ShowBackgroundImageStoryboard">
        <DoubleAnimation Storyboard.TargetName="RootCanvasBackgroundImage" Storyboard.TargetProperty="Opacity" From="0.03" To="1" Duration="0:0:0.1" />
      </Storyboard>
      <Storyboard x:Key="HiddenBackgroundImageStoryboard">
        <DoubleAnimation Storyboard.TargetName="RootCanvasBackgroundImage" Storyboard.TargetProperty="Opacity" From="1" To="0.03" Duration="0:0:0.1" />
      </Storyboard>
      <Storyboard x:Key="ShowButtonStoryboard">
        <DoubleAnimation Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" From="0" To="1" Duration="0:0:0.2" />
        <DoubleAnimation Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" From="0" To="1" Duration="0:0:0.2" />
      </Storyboard>
      <GradientStopCollection x:Key="LinearGradientStops">
        <GradientStop Color="#66000000" Offset="0" />
        <GradientStop Color="#00000000" Offset="1" />
      </GradientStopCollection>
      <LinearGradientBrush x:Key="TopLinearGradientBrush" StartPoint="0.5,0" EndPoint="0.5,1" GradientStops="{StaticResource LinearGradientStops}" />
      <LinearGradientBrush x:Key="LeftLinearGradientBrush" StartPoint="0,0.5" EndPoint="1,0.5" GradientStops="{StaticResource LinearGradientStops}" />
      <LinearGradientBrush x:Key="RightLinearGradientBrush" StartPoint="1,0.5" EndPoint="0,0.5" GradientStops="{StaticResource LinearGradientStops}" />
      <LinearGradientBrush x:Key="BottomLinearGradientBrush" StartPoint="0.5,1" EndPoint="0.5,0" GradientStops="{StaticResource LinearGradientStops}" />
      <!-- 放大镜工具按钮（关灯 / 关闭）：图标与文字都在 Content 里，靠一层覆盖整块的
           CoverBorder 响应悬停 / 按下，整块一起变色（沿用原版 AccentButton 的做法）。
           覆盖层颜色用主题相关的 BorderBrush，深浅主题自动适配；透明度由按钮组统一控制。 -->
      <Style x:Key="Style.MagnifierToolButton" TargetType="{x:Type Button}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Grid Background="Transparent">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Border Name="CoverBorder" Background="Transparent" CornerRadius="3" IsHitTestVisible="False" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="CoverBorder" Property="Background" Value="{DynamicResource Theme.BorderBrush}" />
                  <Setter TargetName="CoverBorder" Property="Opacity" Value="0.35" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="CoverBorder" Property="Background" Value="{DynamicResource Theme.BorderBrush}" />
                  <Setter TargetName="CoverBorder" Property="Opacity" Value="0.7" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="Style.MagnifierToolToggle" TargetType="{x:Type CheckBox}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type CheckBox}">
              <Grid Background="Transparent">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Border Name="CoverBorder" Background="Transparent" CornerRadius="3" IsHitTestVisible="False" />
              </Grid>
              <ControlTemplate.Triggers>
                <!-- 未选中的悬停：只给一层很淡的底色，明确表示「这只是鼠标经过，不是选中」。
                     关灯/开灯只由 IsChecked 决定，图标也按它在亮/灭灯泡间切换。 -->
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsChecked" Value="False" />
                  </MultiTrigger.Conditions>
                  <Setter TargetName="CoverBorder" Property="Background" Value="{DynamicResource Theme.BorderBrush}" />
                  <Setter TargetName="CoverBorder" Property="Opacity" Value="0.15" />
                </MultiTrigger>
                <!-- 选中态（关灯模式）：明显的常亮底色 + 描边，一眼可辨；放在 hover 之后，
                     保证鼠标停留时也维持选中视觉，不会看起来像「没关灯」。 -->
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="CoverBorder" Property="Background" Value="{DynamicResource Theme.IconBrush}" />
                  <Setter TargetName="CoverBorder" Property="Opacity" Value="0.22" />
                  <Setter TargetName="CoverBorder" Property="BorderBrush" Value="{DynamicResource Theme.IconBrush}" />
                  <Setter TargetName="CoverBorder" Property="BorderThickness" Value="1" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="CoverBorder" Property="Background" Value="{DynamicResource Theme.BorderBrush}" />
                  <Setter TargetName="CoverBorder" Property="Opacity" Value="0.5" />
                  <Setter TargetName="CoverBorder" Property="BorderThickness" Value="0" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Canvas Name="RootCanvas" MouseLeftButtonDown="MagnifierRectangle_OnMouseLeftButtonDown" MouseMove="MagnifierRectangle_OnMouseMove" MouseLeftButtonUp="MagnifierRectangle_OnMouseLeftButtonUp">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="AdaptiveStates">
        <VisualState x:Name="Adaptive0">
          <Storyboard>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="InnerLeftTopThumbBorder" Storyboard.TargetProperty="(FrameworkElement.Width)">
              <EasingDoubleKeyFrame KeyTime="0" Value="10" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="InnerLeftTopThumbBorder" Storyboard.TargetProperty="(FrameworkElement.Height)">
              <EasingDoubleKeyFrame KeyTime="0" Value="10" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LightIconGrid" Storyboard.TargetProperty="(FrameworkElement.Width)">
              <EasingDoubleKeyFrame KeyTime="0" Value="18" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LightIconGrid" Storyboard.TargetProperty="(FrameworkElement.Height)">
              <EasingDoubleKeyFrame KeyTime="0" Value="18" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ClosePath" Storyboard.TargetProperty="(FrameworkElement.Width)">
              <EasingDoubleKeyFrame KeyTime="0" Value="18" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ClosePath" Storyboard.TargetProperty="(FrameworkElement.Height)">
              <EasingDoubleKeyFrame KeyTime="0" Value="18" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LightTextBlock" Storyboard.TargetProperty="FontSize">
              <EasingDoubleKeyFrame KeyTime="0" Value="10" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CloseTextBlock" Storyboard.TargetProperty="FontSize">
              <EasingDoubleKeyFrame KeyTime="0" Value="10" />
            </DoubleAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="CornerRadius">
              <DiscreteObjectKeyFrame KeyTime="0">
                <ObjectKeyFrame.Value>
                  <CornerRadius>2</CornerRadius>
                </ObjectKeyFrame.Value>
              </DiscreteObjectKeyFrame>
            </ObjectAnimationUsingKeyFrames>
          </Storyboard>
        </VisualState>
        <VisualState x:Name="Adaptive1440" />
        <VisualState x:Name="Adaptive3800">
          <Storyboard>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="InnerLeftTopThumbBorder" Storyboard.TargetProperty="(FrameworkElement.Width)">
              <EasingDoubleKeyFrame KeyTime="0" Value="32" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="InnerLeftTopThumbBorder" Storyboard.TargetProperty="(FrameworkElement.Height)">
              <EasingDoubleKeyFrame KeyTime="0" Value="32" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LightIconGrid" Storyboard.TargetProperty="(FrameworkElement.Width)">
              <EasingDoubleKeyFrame KeyTime="0" Value="44" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LightIconGrid" Storyboard.TargetProperty="(FrameworkElement.Height)">
              <EasingDoubleKeyFrame KeyTime="0" Value="44" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ClosePath" Storyboard.TargetProperty="(FrameworkElement.Width)">
              <EasingDoubleKeyFrame KeyTime="0" Value="44" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ClosePath" Storyboard.TargetProperty="(FrameworkElement.Height)">
              <EasingDoubleKeyFrame KeyTime="0" Value="44" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LightTextBlock" Storyboard.TargetProperty="FontSize">
              <EasingDoubleKeyFrame KeyTime="0" Value="24" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CloseTextBlock" Storyboard.TargetProperty="FontSize">
              <EasingDoubleKeyFrame KeyTime="0" Value="24" />
            </DoubleAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="CornerRadius">
              <DiscreteObjectKeyFrame KeyTime="0">
                <ObjectKeyFrame.Value>
                  <CornerRadius>6</CornerRadius>
                </ObjectKeyFrame.Value>
              </DiscreteObjectKeyFrame>
            </ObjectAnimationUsingKeyFrames>
          </Storyboard>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <i:Interaction.Triggers>
      <pptService:AdaptiveTrigger MinWindowHeight="0">
        <core:GoToStateAction xmlns:core="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" StateName="Adaptive0" />
      </pptService:AdaptiveTrigger>
      <pptService:AdaptiveTrigger MinWindowHeight="770">
        <GoToStateAction StateName="Adaptive1440" xmlns="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" />
      </pptService:AdaptiveTrigger>
      <pptService:AdaptiveTrigger MinWindowHeight="2100">
        <GoToStateAction StateName="Adaptive3800" xmlns="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" />
      </pptService:AdaptiveTrigger>
    </i:Interaction.Triggers>
    <Panel.Background>
      <ImageBrush x:Name="RootCanvasBackgroundImage" Stretch="Fill" />
    </Panel.Background>
    <Grid Name="RootGrid" Canvas.Left="0" Canvas.Top="0" Canvas.Right="0" Canvas.Bottom="0" SnapsToDevicePixels="True">
      <Border Name="InnerMagnifierBorder" BorderThickness="4" BorderBrush="#C6C6C6">
        <Rectangle Name="MagnifierRectangle" IsManipulationEnabled="True" MouseLeftButtonDown="MagnifierRectangle_OnMouseLeftButtonDown" MouseMove="MagnifierRectangle_OnMouseMove" MouseLeftButtonUp="MagnifierRectangle_OnMouseLeftButtonUp" ManipulationStarting="MagnifierRectangle_OnManipulationStarting" ManipulationDelta="MagnifierRectangle_OnManipulationDelta" ManipulationCompleted="MagnifierRectangle_OnManipulationCompleted" MouseWheel="MagnifierRectangle_OnMouseWheel">
          <Shape.Fill>
            <ImageBrush x:Name="MagnifierImage" ViewboxUnits="Absolute" ViewportUnits="RelativeToBoundingBox" Viewport="0,0,1,1" />
          </Shape.Fill>
        </Rectangle>
      </Border>
      <Grid Name="InnerMagnifierShadowGrid" Column="0" Margin="4" SnapsToDevicePixels="True">
        <Rectangle Fill="{StaticResource TopLinearGradientBrush}" VerticalAlignment="Top" Height="6" />
        <Rectangle Fill="{StaticResource LeftLinearGradientBrush}" HorizontalAlignment="Left" Width="6" />
        <Rectangle Fill="{StaticResource RightLinearGradientBrush}" HorizontalAlignment="Right" Width="6" />
        <Rectangle Fill="{StaticResource BottomLinearGradientBrush}" VerticalAlignment="Bottom" Height="6" />
      </Grid>
      <Grid Name="MagnifierBorder" Column="0" Margin="-30" MinWidth="210" MinHeight="210">
        <Border Name="LeftTopThumbBorder" Width="64" Height="64" Background="#00FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" MouseLeftButtonDown="MagnifierBorder_OnMouseLeftButtonDown" MouseMove="MagnifierBorder_OnMouseMove" MouseLeftButtonUp="MagnifierBorder_OnMouseLeftButtonUp">
          <Ellipse Name="InnerLeftTopThumbBorder" Width="16" Height="16" Style="{StaticResource ThumbEllipseStyle}" />
        </Border>
        <Border Name="RightTopThumbBorder" Width="64" Height="64" Background="#00FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" MouseLeftButtonDown="MagnifierBorder_OnMouseLeftButtonDown" MouseMove="MagnifierBorder_OnMouseMove" MouseLeftButtonUp="MagnifierBorder_OnMouseLeftButtonUp">
          <Ellipse Name="InnerRightTopThumbBorder" Style="{StaticResource ThumbEllipseStyle}" Width="{Binding Width, ElementName=InnerLeftTopThumbBorder}" Height="{Binding Height, ElementName=InnerLeftTopThumbBorder}" />
        </Border>
        <Border Name="LeftBottomThumbBorder" Width="64" Height="64" Background="#00FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" MouseLeftButtonDown="MagnifierBorder_OnMouseLeftButtonDown" MouseMove="MagnifierBorder_OnMouseMove" MouseLeftButtonUp="MagnifierBorder_OnMouseLeftButtonUp">
          <Ellipse Name="InnerLeftBottomThumbBorder" Style="{StaticResource ThumbEllipseStyle}" Width="{Binding Width, ElementName=InnerLeftTopThumbBorder}" Height="{Binding Height, ElementName=InnerLeftTopThumbBorder}" />
        </Border>
        <Border Name="RightBottomThumbBorder" Width="64" Height="64" Background="#00FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" MouseLeftButtonDown="MagnifierBorder_OnMouseLeftButtonDown" MouseMove="MagnifierBorder_OnMouseMove" MouseLeftButtonUp="MagnifierBorder_OnMouseLeftButtonUp">
          <Ellipse Name="InnerRightBottomThumbBorder" Style="{StaticResource ThumbEllipseStyle}" Width="{Binding Width, ElementName=InnerLeftTopThumbBorder}" Height="{Binding Height, ElementName=InnerLeftTopThumbBorder}" />
        </Border>
      </Grid>
    </Grid>
    <!-- 关灯 / 关闭按钮组：贴在放大镜矩形下边缘外面、水平居中；两个按钮平分工具条宽度，
         图标与文字都在按钮 Content 里，整块一起响应悬停 / 按下变色。
         背景用主题画刷，深浅主题与透明度自动适配。 -->
    <Border Name="ButtonBorder" Width="100" Height="52" Background="{DynamicResource Theme.PanelBackground}" CornerRadius="4" BorderThickness="1" SnapsToDevicePixels="True" BorderBrush="{DynamicResource Theme.BorderBrush}" RenderTransformOrigin="0.5,0.5">
      <UIElement.RenderTransform>
        <TransformGroup>
          <ScaleTransform />
        </TransformGroup>
      </UIElement.RenderTransform>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <CheckBox Name="ChangeBackgroundImageCheckBox" Grid.Column="0" Style="{StaticResource Style.MagnifierToolToggle}" IsChecked="False" Click="ChangeBackgroundImageCheckBox_OnClick" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
          <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid x:Name="LightIconGrid" Width="22" Height="22" HorizontalAlignment="Center">
              <Image Source="{StaticResource ImageSource.BulbOn}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Image Source="{StaticResource ImageSource.BulbOff}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image.Style>
                  <Style TargetType="{x:Type Image}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType={x:Type CheckBox}}}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Image.Style>
              </Image>
            </Grid>
            <TextBlock Name="LightTextBlock" Text="关灯" FontSize="12" Foreground="{DynamicResource Theme.IconBrush}" HorizontalAlignment="Center" />
          </StackPanel>
        </CheckBox>
        <Button Name="CloseButton" Grid.Column="1" Style="{StaticResource Style.MagnifierToolButton}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
          <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Path Name="ClosePath" Data="M0,0 M24,24 M13.5,12 L18.7,6.8 C19.1,6.4 19.1,5.7 18.7,5.3 C18.3,4.9 17.6,4.9 17.2,5.3 L12,10.5 L6.8,5.3 C6.4,4.9 5.7,4.9 5.3,5.3 C4.9,5.7 4.9,6.4 5.3,6.8 L10.5,12 L5.3,17.2 C4.9,17.6 4.9,18.3 5.3,18.7 C5.7,19.1 6.4,19.1 6.8,18.7 L12,13.5 L17.2,18.7 C17.6,19.1 18.3,19.1 18.7,18.7 C19.1,18.3 19.1,17.6 18.7,17.2 L13.5,12" Fill="{DynamicResource Theme.IconBrush}" Stretch="Uniform" Width="22" Height="22" HorizontalAlignment="Center" />
            <TextBlock Name="CloseTextBlock" Text="关闭" FontSize="12" Foreground="{DynamicResource Theme.IconBrush}" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
  </Canvas>
</Window>