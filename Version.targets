<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    共享构建版本生成：PPTService / PPTService.Core / PPTService.Collection 三个项目共同导入。
    每个项目在编译前生成自己的 Properties\GitVersionInfo.g.cs（namespace PPTService，internal），
    因此 exe 与两个 dll 拥有完全相同的 ProductVersion / Hash / InformationalVersion。

    build.number 保存「本次构建使用的 build 号」。构建成功后由主程序项目（IsVersionOwner=true）
    统一 +1 写回，供下一次构建使用。递增放在构建之后，保证同一次构建中三个项目读到同一个值，
    也避免 /m 并行构建或项目依赖顺序导致版本不一致 / 重复递增。

    -p:SkipVersionIncrement=true    本次不递增（重复构建 / CI 验证）
    -p:BuildNumberOverride=900      强制本次版本，且不修改 build.number
    -p:GitShortHashOverride=xxxx    强制 hash
    -p:GitWorkingDirectory=<路径>   指定 git 探测目录

    只使用 MSBuild 4.0 / VS2015 支持的任务参数（未使用 15+ 新增参数）。
  -->
  <PropertyGroup>
    <VersionPrefix Condition=" '$(VersionPrefix)' == '' ">1.0.0</VersionPrefix>
    <BuildNumberFile>$(MSBuildProjectDirectory)\..\build.number</BuildNumberFile>
    <NsisVersionFile>$(MSBuildProjectDirectory)\..\setup\Version.nsh</NsisVersionFile>
    <GitVersionFile>$(MSBuildProjectDirectory)\Properties\GitVersionInfo.g.cs</GitVersionFile>
    <GitHashTemp>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)GitHash.tmp</GitHashTemp>
    <GitWorkingDirectory Condition=" '$(GitWorkingDirectory)' == '' ">$(MSBuildProjectDirectory)\..</GitWorkingDirectory>
  </PropertyGroup>

  <!-- 每个项目各自生成常量文件；构建期间 build.number 不变，三个程序集版本必然一致 -->
  <Target Name="GenerateVersionInfo" BeforeTargets="BeforeBuild;CoreCompile"
          Condition=" '$(DesignTimeBuild)' != 'true' ">
    <ItemGroup>
      <GitHashLine Remove="@(GitHashLine)" />
      <GitVersionLine Remove="@(GitVersionLine)" />
      <BuildNumberLine Remove="@(BuildNumberLine)" />
      <NsisVersionLine Remove="@(NsisVersionLine)" />
    </ItemGroup>
    <PropertyGroup>
      <GitShortHash>unknown</GitShortHash>
      <BuildNumber>795</BuildNumber>
    </PropertyGroup>

    <!-- 本次 build 号：读取 build.number（此处不写回） -->
    <ReadLinesFromFile File="$(BuildNumberFile)" Condition="Exists('$(BuildNumberFile)')">
      <Output TaskParameter="Lines" ItemName="BuildNumberLine" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <BuildNumber Condition=" '@(BuildNumberLine)' != '' ">@(BuildNumberLine)</BuildNumber>
      <BuildNumber Condition=" '$(BuildNumberOverride)' != '' ">$(BuildNumberOverride)</BuildNumber>
      <ProductVersionText>$(VersionPrefix).$(BuildNumber)</ProductVersionText>
    </PropertyGroup>

    <!-- git 短 hash：非 git 仓库 / 无 commit / git 不可用 -> unknown -->
    <MakeDir Directories="$(MSBuildProjectDirectory)\$(IntermediateOutputPath)" />
    <Delete Files="$(GitHashTemp)" Condition="Exists('$(GitHashTemp)')" />
    <Exec Command="git rev-parse --short=8 HEAD &gt; &quot;$(GitHashTemp)&quot; 2&gt;NUL"
          WorkingDirectory="$(GitWorkingDirectory)"
          ContinueOnError="true" IgnoreExitCode="true" />
    <ReadLinesFromFile File="$(GitHashTemp)" Condition="Exists('$(GitHashTemp)')">
      <Output TaskParameter="Lines" ItemName="GitHashLine" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <GitShortHash Condition=" '@(GitHashLine)' != '' ">@(GitHashLine)</GitShortHash>
      <GitShortHash Condition=" '$(GitShortHashOverride)' != '' ">$(GitShortHashOverride)</GitShortHash>
      <GitInformationalVersion>$(ProductVersionText) ($(GitShortHash))</GitInformationalVersion>
    </PropertyGroup>

    <!-- 本项目专用常量文件：三个程序集各一份，内容相同但互不写冲突 -->
    <ItemGroup>
      <GitVersionLine Include="// &lt;auto-generated&gt; Generated by MSBuild on every build. Do not edit. &lt;/auto-generated&gt;" />
      <GitVersionLine Include="namespace PPTService" />
      <GitVersionLine Include="{" />
      <GitVersionLine Include="    internal static class GitVersionInfo" />
      <GitVersionLine Include="    {" />
      <GitVersionLine Include="        internal const string ProductVersion = &quot;$(ProductVersionText)&quot;%3B" />
      <GitVersionLine Include="        internal const string Hash = &quot;$(GitShortHash)&quot;%3B" />
      <GitVersionLine Include="        internal const string InformationalVersion = &quot;$(GitInformationalVersion)&quot;%3B" />
      <GitVersionLine Include="    }" />
      <GitVersionLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(GitVersionFile)" Lines="@(GitVersionLine)" Overwrite="true" />

    <!-- NSIS 版本头文件只由主程序项目写一次，避免并行写冲突 -->
    <ItemGroup>
      <NsisVersionLine Include="!define PRODUCT_VERSION &quot;$(ProductVersionText)&quot;" />
    </ItemGroup>
    <WriteLinesToFile File="$(NsisVersionFile)" Lines="@(NsisVersionLine)" Overwrite="true"
                      Condition=" '$(IsVersionOwner)' == 'true' " />

    <Message Importance="High" Text="$(MSBuildProjectName) version: $(GitInformationalVersion) [build $(BuildNumber)]" />
  </Target>

  <!-- 构建成功后递增，供下一次构建使用；只由主程序项目执行，失败构建不消耗版本号 -->
  <Target Name="IncrementBuildNumber" AfterTargets="Build"
          Condition=" '$(IsVersionOwner)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(SkipVersionIncrement)' != 'true' and '$(BuildNumberOverride)' == '' ">
    <ItemGroup>
      <NextBuildNumberLine Remove="@(NextBuildNumberLine)" />
    </ItemGroup>
    <ReadLinesFromFile File="$(BuildNumberFile)" Condition="Exists('$(BuildNumberFile)')">
      <Output TaskParameter="Lines" ItemName="NextBuildNumberLine" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <NextBuildNumber Condition=" '@(NextBuildNumberLine)' != '' ">@(NextBuildNumberLine)</NextBuildNumber>
      <NextBuildNumber Condition=" '$(NextBuildNumber)' == '' ">795</NextBuildNumber>
      <NextBuildNumber>$([MSBuild]::Add($(NextBuildNumber), 1))</NextBuildNumber>
    </PropertyGroup>
    <WriteLinesToFile File="$(BuildNumberFile)" Lines="$(NextBuildNumber)" Overwrite="true" />
    <Message Importance="High" Text="Next build number: $(NextBuildNumber)" />
  </Target>
</Project>
